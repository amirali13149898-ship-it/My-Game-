BOT_TOKEN=123456:ABC...        # from @BotFather
ADMIN_ID=123456789             # your numeric Telegram id (admin commands + backups are sent here)
# Database: set DATABASE_URL to use Supabase/Postgres; otherwise a local SQLite file (DB_PATH) is used.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_PATH=ardian.db              # SQLite only. With a Volume on Railway: /data/ardian.db
BACKUP_EVERY_HOURS=6           # SQLite only (Supabase has its own backups); 0 disables
BACKUP_KEEP=10
ASSETS_DIR=assets              # folder with <key>.jpg|png pictures (optional)
